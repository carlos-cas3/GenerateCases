# Supabase (solo backend; nunca exponer la clave de servicio al frontend)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Documentos (POST /api/v1/documents)
# Tamaño máximo por archivo en bytes (20 MiB = 20971520).
MAX_UPLOAD_SIZE_BYTES=20971520
# Bucket PRIVADO de Supabase Storage; debe existir antes de arrancar (ver supabase/schema.sql).
DOCUMENTS_BUCKET=docs_testgen

# Pipeline simulado (Fase 1)
PIPELINE_STUB_DELAY_SECONDS=2
# Etapa en la que se inyecta un fallo simulado (p1..p7). Vacío = sin fallo.
PIPELINE_STUB_FAIL_AT_STAGE=

# Método de generación aplicado cuando la solicitud no indica method_type
DEFAULT_METHOD_TYPE=llm_pipeline

# Orígenes del frontend autorizados por CORS (lista separada por comas, sin '*').
# Solo hace falta cuando el navegador llama a la API desde otro origen; el proxy de Vite
# en desarrollo es same-origin. En producción, indica el dominio real del frontend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cliente LLM de P2/P6 (ver docs/llm_client_design.md). Se construye al arrancar:
# si falta una variable obligatoria del proveedor elegido, el servicio no inicia.
# Proveedor: openai | anthropic | ollama
LLM_PROVIDER=openai
# Obligatoria para openai y anthropic.
LLM_API_KEY=
# Obligatoria para ollama (p. ej. http://localhost:11434); opcional como proxy para openai/anthropic.
LLM_BASE_URL=
# Timeout de red por llamada, en segundos.
LLM_TIMEOUT_SECONDS=60
# Nombre del modelo concreto usado por P2/P6 (LlmSettings.model). Obligatorio para generar.
LLM_MODEL=

# Configuración de P1 (camino B: heurística, sin LLM). Ver docs/prompts_fases/Fase 4/plantilla_hu.md
P1_RULES_VERSION=v1
P1_LANGUAGE=es
# Regex que delimita el inicio de una HU en el texto extraído (nivel 2 en markdown).
P1_STORY_DELIMITER_PATTERN=^##\s+.+$
P1_MAX_STORY_CHARS=5000

# Configuración de P2 (LLM en batches). Ver docs/prompts_fases/Fase 4/prompt_p2.md
P2_PROMPT_VERSION=v1
P2_MAX_STORIES_PER_CALL=5
P2_MAX_RETRIES=2

# Embeddings de P3 y clustering de P4. Se construyen al arrancar.
# Proveedor de embeddings: local (sentence-transformers) | openai
EMBEDDINGS_PROVIDER=local
# Nombre del modelo (sentence-transformers u OpenAI). El modelo local se descarga la primera vez.
EMBEDDINGS_MODEL=all-mpnet-base-v2
# Obligatoria solo para openai.
EMBEDDINGS_API_KEY=
# Timeout de red por llamada (solo proveedores remotos), en segundos.
EMBEDDINGS_TIMEOUT_SECONDS=60
# Algoritmo de clustering: hdbscan
CLUSTERING_ALGORITHM=hdbscan
