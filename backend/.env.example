# Supabase (solo backend; nunca exponer la clave de servicio al frontend)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Documentos (POST /api/v1/documents)
# Tamaño máximo por archivo en bytes (20 MiB = 20971520).
MAX_UPLOAD_SIZE_BYTES=20971520
# Bucket PRIVADO de Supabase Storage; debe existir antes de arrancar (ver supabase/schema.sql).
DOCUMENTS_BUCKET=docs_testgen

# Etapas del pipeline: real = P1–P6 reales (heurística, LLM, embeddings, clustering, contexto, generación),
# P7 simulada (Fase 7);
# stub = las 7 simuladas (sin LLM ni RPC de resultados). Con real, LLM_MODEL es obligatoria.
PIPELINE_STAGES=real

# Pipeline simulado (Fase 1; con PIPELINE_STAGES=real solo afecta a P7)
PIPELINE_STUB_DELAY_SECONDS=2
# Etapa en la que se inyecta un fallo simulado (p1..p7). Vacío = sin fallo.
PIPELINE_STUB_FAIL_AT_STAGE=

# Detiene el pipeline tras esta etapa (calibración). Vacío = run completo. Valores: p1..p7.
# Las etapas posteriores quedan skipped y la generación completed con summary parcial.
PIPELINE_STOP_AFTER_STAGE=

# Método de generación aplicado cuando la solicitud no indica method_type
DEFAULT_METHOD_TYPE=llm_pipeline

# Orígenes del frontend autorizados por CORS (lista separada por comas, sin '*').
# Solo hace falta cuando el navegador llama a la API desde otro origen; el proxy de Vite
# en desarrollo es same-origin. En producción, indica el dominio real del frontend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cliente LLM de P2/P6 (ver docs/llm_client_design.md). Se construye al arrancar:
# si falta una variable obligatoria del proveedor elegido, el servicio no inicia.
# Proveedor: openai | anthropic | ollama
LLM_PROVIDER=openai
# Obligatoria para openai y anthropic.
LLM_API_KEY=
# Obligatoria para ollama (p. ej. http://localhost:11434); opcional como proxy para openai/anthropic.
LLM_BASE_URL=
# Timeout de red por llamada, en segundos.
LLM_TIMEOUT_SECONDS=60
# Nombre del modelo concreto usado por P2/P6 (LlmSettings.model). Obligatorio para generar.
LLM_MODEL=
# Temperatura de generación (todos los proveedores). 0.0 = extracción determinista.
LLM_TEMPERATURE=0.0
# Solo ollama (ver docs/llm_ollama_context.md): ventana de contexto en tokens (el default de
# Ollama, 4096, trunca el JSON de P2) y modo thinking (apagado: devora el contexto sin aportar).
LLM_NUM_CTX=16384
LLM_THINK=false

# Configuración de P1 (camino B: heurística, sin LLM). Ver docs/prompts_fases/Fase 4/plantilla_hu.md
P1_RULES_VERSION=v1
P1_LANGUAGE=es
# Regex que delimita el inicio de una HU en el texto extraído (nivel 2 en markdown).
P1_STORY_DELIMITER_PATTERN=^##\s+.+$
P1_MAX_STORY_CHARS=5000

# Configuración de P2 (LLM en batches). Ver docs/prompts_fases/Fase 4/prompt_p2.md
P2_PROMPT_VERSION=v1
P2_MAX_STORIES_PER_CALL=5
P2_MAX_RETRIES=2

# Embeddings de P3 y clustering de P4. Se construyen al arrancar.
# Proveedor de embeddings: local (sentence-transformers) | openai
EMBEDDINGS_PROVIDER=local
# Nombre del modelo (sentence-transformers u OpenAI). El modelo local se descarga la primera vez.
EMBEDDINGS_MODEL=all-mpnet-base-v2
# Obligatoria solo para openai.
EMBEDDINGS_API_KEY=
# Timeout de red por llamada (solo proveedores remotos), en segundos.
EMBEDDINGS_TIMEOUT_SECONDS=60
# Algoritmo de clustering: hdbscan
CLUSTERING_ALGORITHM=hdbscan

# Configuración de P3 (embeddings en lotes). Ver docs/prompts_fases/Fase 5/fase5.md
# Normalización L2 de los vectores (necesaria para la métrica cosine).
P3_NORMALIZE=true
# Texto vectorizado por RF. Por defecto solo {description}: el código (RF-001) es un
# identificador sin semántica y añade ruido al embedding. Admite {code} y {description}.
P3_INPUT_TEMPLATE={description}
# RF por llamada al proveedor de embeddings.
P3_BATCH_SIZE=32
# Reintentos por lote ante fallos transitorios (timeout, rate limit). No se reintentan
# errores de dimensión ni vectores inválidos.
P3_MAX_RETRIES=2

# Configuración de P4 (clustering). Pisos mínimos de HDBSCAN, no tamaños forzados:
# si salen clusters demasiado chicos, sube P4_MIN_CLUSTER_SIZE; si queda mucho RF sin asignar, bájalo.
P4_METRIC=cosine
P4_MIN_CLUSTER_SIZE=2
P4_MIN_SAMPLES=1

# Configuración de P5 (contexto estructurado). Ver docs/prompts_fases/Fase 6/fase6.md
# Umbral del estimado de tokens por unidad (caracteres / 4, heurístico). Una unidad que lo
# supera se marca exceeds_limit y emite UNIT_EXCEEDS_TOKEN_LIMIT; no se parte ni se descarta.
# Si unidades marcadas funcionan bien en P6, súbelo; si unidades sin marcar dan casos pobres, bájalo.
P5_MAX_TOKENS_PER_UNIT=8000
# Versión de P5: cubre la agrupación y el output_spec de P6. Súbela si cambia cualquiera de los dos.
P5_INSTRUCTIONS_VERSION=v1
# Prerrequisitos entre RF (D-17). Siempre false en v1.
P5_INCLUDE_PREREQUISITES=false

# Configuración de P6 (generación de casos de prueba). Ver docs/prompts_fases/Fase 7/fase7.md
# Versión de los prompts de P6 (contexto / contexto_sin_clustering). Súbela si cambia su redacción.
P6_PROMPT_VERSION=v2
# Reintentos por unidad ante JSON inválido o fallo transitorio del LLM (no se reintenta LLM_CONTEXT_LENGTH).
P6_MAX_RETRIES=1
# Proporción máxima de unidades fallidas (0.0–1.0). Si fallidas/total la supera, la generación queda
# failed; si no, queda completed con aviso UNIT_GENERATION_FAILED. 0.0 = cualquier fallo es fatal.
P6_FAILURE_THRESHOLD=0.0
# Tope de casos por unidad = min(P6_MAX_CASES_MULTIPLIER × RF objetivo, P6_MAX_CASES_ABSOLUTE).
# Si el LLM devuelve más, se truncan con aviso CASES_TRUNCATED.
P6_MAX_CASES_MULTIPLIER=3
P6_MAX_CASES_ABSOLUTE=50

# Pruebas de integración contra Supabase real (Fase 8, docs/prompts_fases/Fase 8/fase8.md).
# Excluidas de `pytest` por defecto; se ejecutan con: RUN_SUPABASE_TESTS=1 pytest -m integration
RUN_SUPABASE_TESTS=
# Opción 1 (recomendada, D-F8-3): proyecto Supabase aparte, sin datos reales.
SUPABASE_URL_TEST=
SUPABASE_SERVICE_ROLE_KEY_TEST=
# Opción 2: usar el proyecto de SUPABASE_URL (con datos reales). Cada test crea y borra solo
# sus propias filas. Déjala vacía salvo que se haya decidido explícitamente.
SUPABASE_TESTS_ALLOW_SHARED_PROJECT=
