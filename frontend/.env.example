# URL base de la API. Vacío = rutas relativas (/api/...) a través del proxy de Vite en desarrollo.
# En producción, si frontend y backend están en dominios distintos, indica la URL real del backend
# (y añade el origen del frontend a FRONTEND_ORIGINS en el backend).
VITE_API_URL=

# Solo Fase 1.5: documento del seed (backend/supabase/seed.sql) usado al iniciar una generación,
# porque todavía no existe POST /documents. Las variables VITE_* llegan al navegador: sin secretos.
VITE_DEV_DOCUMENT_ID=6f9d1c2e-0a4b-4c8d-9e1f-2b3c4d5e6f70
